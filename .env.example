# ─── Ethereum / Sepolia ───────────────────────────────────────────────────────
# Get a free RPC URL from https://infura.io or https://alchemy.com
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Export this from MetaMask → Account Details → Export Private Key
# Use a DEDICATED wallet for this project — never your main wallet
PRIVATE_KEY=your_sepolia_wallet_private_key_here

# Get from https://etherscan.io/myapikey (free account)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Filled in after running: npx hardhat run scripts/deploy.js --network sepolia
CONTRACT_ADDRESS=0xYourDeployedContractAddress

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ─── Database ────────────────────────────────────────────────────────────────
# Used when running backend directly (without Docker)
DATABASE_URL=postgresql://certchain_user:certchain_pass@localhost:5432/certchain
